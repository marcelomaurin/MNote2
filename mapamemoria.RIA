-- calibracoes
CREATE TABLE calibracoes (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,
  id_equipamento   INTEGER NOT NULL,
  id_prestador 
    INTEGER,

  data_calibracao  VARCHAR(10) NOT NULL,
  resultado        VARCHAR(30),          -- APROVADO/REPROVADO
  observacoes      
TEXT,                 -- longo
  proxima_prevista VARCHAR(10),

  dtcad            VARCHAR(19) NOT NULL DEFAULT (datetime('now')),

  
CONSTRAINT fk_calib_equip
    FOREIGN KEY (id_equipamento) REFERENCES equipamentos(id)
    ON UPDATE CASCADE
    ON DELETE 
CASCADE,

  CONSTRAINT fk_calib_prestador
    FOREIGN KEY (id_prestador) REFERENCES prestadores_pj(id)
    ON UPDATE CASCADE
    
ON DELETE SET NULL
);

-- categorias
CREATE TABLE categorias (
  id        INTEGER PRIMARY KEY AUTOINCREMENT,
  nome      VARCHAR(100) NOT NULL,
  descricao 
VARCHAR(255),
  ativo     INTEGER NOT NULL DEFAULT 1,
  dtcad     VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  dtalt     
VARCHAR(19)
);

-- contratos
CREATE TABLE contratos (id INTEGER PRIMARY KEY AUTOINCREMENT, numero VARCHAR (50), titulo VARCHAR (150), objeto TEXT, 
observacoes TEXT, dtinicio VARCHAR (10), dtfim VARCHAR (10), valor NUMERIC, status INTEGER NOT NULL DEFAULT 1, dtcad 
DATETIME NOT NULL DEFAULT (datetime('now')));

-- contratos_equipamentos
CREATE TABLE contratos_equipamentos (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  id_contrato   INTEGER NOT NULL,
  
id_equipamento INTEGER NOT NULL,

  dtcad         DATETIME NOT NULL DEFAULT (datetime('now')),
  status        INTEGER NOT NULL 
DEFAULT 1,

  FOREIGN KEY (id_contrato)    REFERENCES contratos(id)     ON DELETE CASCADE,
  FOREIGN KEY (id_equipamento) 
REFERENCES equipamentos(id)  ON DELETE CASCADE,

  UNIQUE (id_contrato, id_equipamento)
);

-- contratos_prestadores_pj
CREATE TABLE contratos_prestadores_pj (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,
  id_contrato      INTEGER NOT NULL,
  
id_prestador_pj  INTEGER NOT NULL,

  dtcad            DATETIME NOT NULL DEFAULT (datetime('now')),
  status           INTEGER NOT NULL 
DEFAULT 1,

  FOREIGN KEY (id_contrato)     REFERENCES contratos(id)      ON DELETE CASCADE,
  FOREIGN KEY (id_prestador_pj) 
REFERENCES prestadores_pj(id) ON DELETE CASCADE,

  UNIQUE (id_contrato, id_prestador_pj)
);

-- contratos_tipos_equipamento
CREATE TABLE contratos_tipos_equipamento (
  id                INTEGER PRIMARY KEY AUTOINCREMENT,
  id_contrato       INTEGER NOT 
NULL,
  id_tipo_equipamento INTEGER NOT NULL,

  dtcad             DATETIME NOT NULL DEFAULT (datetime('now')),
  status            
INTEGER NOT NULL DEFAULT 1,

  FOREIGN KEY (id_contrato)        REFERENCES contratos(id)         ON DELETE CASCADE,
  FOREIGN KEY 
(id_tipo_equipamento) REFERENCES tipos_equipamento(id) ON DELETE CASCADE,

  UNIQUE (id_contrato, id_tipo_equipamento)
);

-- documentos
CREATE TABLE documentos (
  id                INTEGER PRIMARY KEY AUTOINCREMENT,
  caminho_documento VARCHAR(500) NOT NULL,
  
dtcad             DATETIME NOT NULL DEFAULT (datetime('now')),
  tipo_documento    VARCHAR(50) NOT NULL,
  status            INTEGER 
NOT NULL DEFAULT 1
);

-- documentos_contratos
CREATE TABLE documentos_contratos (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  id_contrato  INTEGER NOT NULL,
  
id_documento INTEGER NOT NULL,

  FOREIGN KEY (id_contrato)  REFERENCES contratos(id)  ON DELETE CASCADE,
  FOREIGN KEY 
(id_documento) REFERENCES documentos(id) ON DELETE CASCADE,

  UNIQUE (id_contrato, id_documento)
);

-- documentos_equipamentos
CREATE TABLE documentos_equipamentos (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  id_equipamento INTEGER NOT 
NULL,
  id_documento   INTEGER NOT NULL,

  FOREIGN KEY (id_equipamento) REFERENCES equipamentos(id) ON DELETE CASCADE,
  
FOREIGN KEY (id_documento)   REFERENCES documentos(id)   ON DELETE CASCADE,

  UNIQUE (id_equipamento, id_documento)
);

-- documentos_prestador_pj
CREATE TABLE documentos_prestador_pj (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  id_prestador_pj INTEGER NOT NULL,
  
id_documento    INTEGER NOT NULL,

  FOREIGN KEY (id_prestador_pj) REFERENCES prestadores_pj(id) ON DELETE CASCADE,
  FOREIGN 
KEY (id_documento)    REFERENCES documentos(id)     ON DELETE CASCADE,

  UNIQUE (id_prestador_pj, id_documento)
);

-- documentos_tipo_equipamentos
CREATE TABLE documentos_tipo_equipamentos (
  id                 INTEGER PRIMARY KEY AUTOINCREMENT,
  id_tipo_equipamento 
INTEGER NOT NULL,
  id_documento        INTEGER NOT NULL,

  FOREIGN KEY (id_tipo_equipamento) REFERENCES tipos_equipamento
(id) ON DELETE CASCADE,
  FOREIGN KEY (id_documento)        REFERENCES documentos(id)        ON DELETE CASCADE,

  UNIQUE 
(id_tipo_equipamento, id_documento)
);

-- emails_enviados
CREATE TABLE emails_enviados (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,

  -- destinatários
  para_email        VARCHAR(255) 
NOT NULL,
  cc_email          VARCHAR(500),
  cco_email         VARCHAR(500),

  -- remetente
  de_nome           VARCHAR(150),
  de_email        
  VARCHAR(255),

  -- conteúdo (assunto cabe em varchar)
  assunto           VARCHAR(255),

  -- corpo pode ser grande => TEXT
  
corpo_texto       TEXT,
  corpo_html        TEXT,

  -- anexos pode virar uma lista grande/JSON => TEXT
  anexos            TEXT,

  -- data/hora 
ISO
  dt_envio          VARCHAR(19) NOT NULL,  -- 'YYYY-MM-DD HH:MM:SS'

  -- controle
  enviado           INTEGER NOT NULL DEFAULT 0, 
-- 0=não, 1=sim
  tentativas        INTEGER NOT NULL DEFAULT 0,
  ultima_tentativa  VARCHAR(19),                -- 'YYYY-MM-DD 
HH:MM:SS'

  -- erro pode ser longo => TEXT
  erro              TEXT,

  -- auditoria local
  dt_cadastro       VARCHAR(19) NOT NULL DEFAULT 
(datetime('now'))
, id_usuario INTEGER);

-- emails_recebidos
CREATE TABLE emails_recebidos (
  id                 INTEGER PRIMARY KEY AUTOINCREMENT,

  -- identificação do e-mail no servidor 
(opcional, mas ajuda a evitar duplicidade)
  message_id         TEXT UNIQUE,

  -- dados do remetente
  de_nome            TEXT,
  de_email        
   TEXT,

  -- dados do destinatário (se quiser registrar)
  para_email         TEXT,

  -- assunto e corpo
  assunto            TEXT,
  corpo_texto        
TEXT,
  corpo_html         TEXT,

  -- DATA/HORA DE RECEBIMENTO (o que você pediu)
  dt_recebimento     TEXT NOT NULL,  -- formato 
ISO: 'YYYY-MM-DD HH:MM:SS'

  -- auditoria local (quando gravou no SQLite)
  dt_cadastro        TEXT NOT NULL DEFAULT (datetime
('now'))
);

-- equipamentos
CREATE TABLE equipamentos (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,
  id_modelo        INTEGER NOT NULL,

  patrimonio   
    VARCHAR(60),
  num_serie        VARCHAR(80) NOT NULL,

  data_compra      VARCHAR(10),     -- YYYY-MM-DD
  data_inicio_uso  
VARCHAR(10),     -- YYYY-MM-DD

  valor_compra     REAL,
  vida_util_meses  INTEGER,
  valor_depreciado REAL,

  local_unidade    
VARCHAR(120),
  local_setor      VARCHAR(120),
  local_sala       VARCHAR(120),

  status           VARCHAR(30) NOT NULL DEFAULT 'ATIVO',
  
observacoes      TEXT,            -- longo (ok TEXT)

  ativo            INTEGER NOT NULL DEFAULT 1,
  dtcad            VARCHAR(19) NOT NULL 
DEFAULT (datetime('now')),
  dtalt            VARCHAR(19), id_tipo_equipamento INTEGER,

  CONSTRAINT fk_equip_modelo
    FOREIGN KEY 
(id_modelo) REFERENCES modelos(id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
);

-- equipamentos_emails_enviados
CREATE TABLE equipamentos_emails_enviados (
    id_equipamento INTEGER NOT NULL,
    id_email       INTEGER NOT NULL,

    PRIMARY 
KEY (id_equipamento, id_email),

    FOREIGN KEY (id_equipamento)
      REFERENCES equipamentos (id)
      ON UPDATE CASCADE
      ON 
DELETE CASCADE,

    FOREIGN KEY (id_email)
      REFERENCES emails_enviados (id)
      ON UPDATE CASCADE
      ON DELETE CASCADE
);

-- equipamentos_emails_recebidos
CREATE TABLE equipamentos_emails_recebidos (
    id_equipamento INTEGER NOT NULL,
    id_email       INTEGER NOT NULL,

    
PRIMARY KEY (id_equipamento, id_email),

    FOREIGN KEY (id_equipamento)
      REFERENCES equipamentos (id)
      ON UPDATE 
CASCADE
      ON DELETE CASCADE,

    FOREIGN KEY (id_email)
      REFERENCES emails_recebidos (id)
      ON UPDATE CASCADE
      ON 
DELETE CASCADE
);

-- eventos
CREATE TABLE eventos (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  id_usuario      INTEGER NOT NULL,
  dthrnotificacao TEXT 
   NOT NULL,      -- guarde como ISO 'YYYY-MM-DD HH:MM:SS'
  titulo          TEXT    NOT NULL,
  descricao       TEXT,
  visto           
INTEGER NOT NULL DEFAULT 0, -- 0=não visto, 1=visto
  dtcad           TEXT    NOT NULL DEFAULT (datetime('now')),

  FOREIGN KEY 
(id_usuario) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- log_operacoes
CREATE TABLE log_operacoes (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,

    id_usuario    INTEGER NOT NULL,
    login         
VARCHAR(50),

    operacao      VARCHAR(50) NOT NULL,   -- INSERT / UPDATE / DELETE / LOGIN / LOGOUT
    entidade      VARCHAR(50) 
NOT NULL,   -- tabela ou módulo
    id_registro   INTEGER,                 -- id afetado

    descricao     TEXT,                    -- texto livre

    datahora  
    DATETIME DEFAULT (datetime('now')),

    ip            VARCHAR(50),
    maquina       VARCHAR(100)
);

-- manutencoes
CREATE TABLE manutencoes (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,
  id_equipamento   INTEGER NOT NULL,
  
id_prestador     INTEGER,

  tipo_manutencao  VARCHAR(20) NOT NULL, -- CORRETIVA/PREVENTIVA/PREDITIVA
  data_abertura    
VARCHAR(10) NOT NULL,
  data_conclusao   VARCHAR(10),

  descricao        TEXT,                 -- longo
  resultado        VARCHAR(30),          -- 
APROVADO/REPROVADO/RETORNO
  proxima_prevista VARCHAR(10),

  documento_ref    VARCHAR(255),

  dtcad            VARCHAR(19) 
NOT NULL DEFAULT (datetime('now')),

  CONSTRAINT fk_manut_equip
    FOREIGN KEY (id_equipamento) REFERENCES equipamentos
(id)
    ON UPDATE CASCADE
    ON DELETE CASCADE,

  CONSTRAINT fk_manut_prestador
    FOREIGN KEY (id_prestador) REFERENCES 
prestadores_pj(id)
    ON UPDATE CASCADE
    ON DELETE SET NULL
);

-- marcas
CREATE TABLE marcas (
  id        INTEGER PRIMARY KEY AUTOINCREMENT,
  nome      VARCHAR(120) NOT NULL,
  ativo     INTEGER NOT 
NULL DEFAULT 1,
  dtcad     VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  dtalt     VARCHAR(19)
);

-- modelos
CREATE TABLE modelos (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  id_tipo      INTEGER NOT NULL,
  id_marca     INTEGER 
NOT NULL,

  nome_modelo  VARCHAR(150) NOT NULL,
  versao       VARCHAR(50),
  observacoes  TEXT,                -- longo (ok TEXT)

  ativo 
       INTEGER NOT NULL DEFAULT 1,
  dtcad        VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  dtalt        VARCHAR(19),

  
CONSTRAINT fk_modelos_tipo
    FOREIGN KEY (id_tipo) REFERENCES tipos_equipamento(id)
    ON UPDATE CASCADE
    ON DELETE 
RESTRICT,

  CONSTRAINT fk_modelos_marca
    FOREIGN KEY (id_marca) REFERENCES marcas(id)
    ON UPDATE CASCADE
    ON DELETE 
RESTRICT
);

-- movimentacao_equipamento
CREATE TABLE movimentacao_equipamento (
    id                  INTEGER       PRIMARY KEY AUTOINCREMENT,
    id_equipamento      
INTEGER       NOT NULL,
    dt_mov              VARCHAR(19)   NOT NULL DEFAULT (datetime('now')),
    tipo_mov            VARCHAR(30),

    -- 
destino
    id_unidade_destino  INTEGER,
    setor_destino       VARCHAR(120),
    sala_destino        VARCHAR(120),

    -- status
    id_status       
    INTEGER,

    observacoes         TEXT,

    usuario             VARCHAR(120),
    ativo               INTEGER       NOT NULL DEFAULT 1,
    dtcad             
  VARCHAR(19)   NOT NULL DEFAULT (datetime('now')),
    dtalt               VARCHAR(19),

    CONSTRAINT fk_mov_equip FOREIGN KEY 
(id_equipamento)
        REFERENCES equipamentos (id) ON UPDATE CASCADE ON DELETE RESTRICT,

    CONSTRAINT fk_mov_unid_dest 
FOREIGN KEY (id_unidade_destino)
        REFERENCES unidades (id) ON UPDATE CASCADE ON DELETE SET NULL,

    CONSTRAINT 
fk_mov_status FOREIGN KEY (id_status)
        REFERENCES status_equipamento (id) ON UPDATE CASCADE ON DELETE SET NULL
);

-- ordens_servico
CREATE TABLE ordens_servico (
  id                     INTEGER PRIMARY KEY AUTOINCREMENT,
  id_pessoa_solicitante  INTEGER NOT NULL,
  
id_equipamento         INTEGER,   -- agora pode ser nulo
  descricao              TEXT NOT NULL,
  observacao             TEXT,
  id_status_os           
INTEGER NOT NULL,
  dtcadastro             VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  ativo                  INTEGER NOT NULL 
DEFAULT 1,
  dtalt                  VARCHAR(19),

  CONSTRAINT fk_os_pessoa
    FOREIGN KEY (id_pessoa_solicitante) REFERENCES pessoas(id)
  
  ON UPDATE CASCADE
    ON DELETE RESTRICT,

  CONSTRAINT fk_os_equip
    FOREIGN KEY (id_equipamento) REFERENCES 
equipamentos(id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,

  CONSTRAINT fk_os_status
    FOREIGN KEY (id_status_os) 
REFERENCES status_os(id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
);

