  descricao     TEXT,
  sql_tpl 
      TEXT NOT NULL,   -- guarda o SQL com ["titulo", TIPO]
  ativo         INTEGER NOT NULL DEFAULT 1,
  criado_em     TEXT NOT NULL 
DEFAULT (datetime('now')),
  atualizado_em TEXT
);

