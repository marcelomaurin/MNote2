-- unidade_emails_recebidos
CREATE TABLE unidade_emails_recebidos (
    id_unidade INTEGER NOT NULL,
    id_email   INTEGER NOT NULL,
    PRIMARY KEY 
(id_unidade, id_email),
    FOREIGN KEY (id_unidade)
      REFERENCES unidades (id) ON UPDATE CASCADE ON DELETE CASCADE,
    
FOREIGN KEY (id_email)
      REFERENCES emails_recebidos (id) ON UPDATE CASCADE ON DELETE CASCADE
);

-- unidades
CREATE TABLE unidades (
    id                    INTEGER       PRIMARY KEY AUTOINCREMENT,

    unidade               VARCHAR(150)  NOT NULL,
    
sigla                 VARCHAR(30),

    -- endereço
    endereco              VARCHAR(200),
    numero                VARCHAR(20),
    bairro                
VARCHAR(120),
    cidade                VARCHAR(120),
    uf                    VARCHAR(2),
    cep                   VARCHAR(12),

    -- contato da unidade
  
  telefone              VARCHAR(50),
    email                 VARCHAR(150),

    -- localização
    latitude              REAL,
    longitude             REAL,
    
url_google_maps       VARCHAR(500),

    -- responsável
    responsavel_nome      VARCHAR(150),
    responsavel_tipo      VARCHAR(50),
    
responsavel_email     VARCHAR(150),
    responsavel_telefone  VARCHAR(50),

    ativo                 INTEGER       NOT NULL DEFAULT 1,
    
dtcad                 VARCHAR(19)  NOT NULL DEFAULT (datetime('now')),
    dtalt                 VARCHAR(19), observacao TEXT, 
responsavel_token VARCHAR(255),

    CHECK (latitude  IS NULL OR (latitude  BETWEEN -90  AND 90)),
    CHECK (longitude IS NULL OR 
(longitude BETWEEN -180 AND 180))
);

-- usuarios
CREATE TABLE usuarios (
  id          INTEGER PRIMARY KEY AUTOINCREMENT,
  login       VARCHAR(50)  NOT NULL,
  nome        VARCHAR
(150) NOT NULL,
  email       VARCHAR(150),
  senha_hash  VARCHAR(255) NOT NULL,
  id_perfil   INTEGER NOT NULL,
  ativo       INTEGER 
NOT NULL DEFAULT 1,
  dtcad       VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  dtalt       VARCHAR(19),

  CONSTRAINT 
fk_usuarios_perfis
    FOREIGN KEY (id_perfil) REFERENCES perfis(id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
);

-- vinculos_pessoa
CREATE TABLE vinculos_pessoa (
  id        INTEGER PRIMARY KEY AUTOINCREMENT,
  nome      VARCHAR(50) NOT NULL UNIQUE, -- EX: 
'CONTRATO','PRESTADOR_PJ','UNIDADE','OS','OUTRO'
  ativo     INTEGER NOT NULL DEFAULT 1,
  dtcad     VARCHAR(19) NOT NULL 
DEFAULT (datetime('now')),
  dtalt     VARCHAR(19)
);


--[FOLDER/PROJETO]------------------------------
Sim, MNote2 é um editor de texto multiplataforma avançado desenvolvido principalmente em Pascal com Lazarus/Free Pascal, que 
foca em simplicidade, eficiência e produtividade. Ele integra múltiplas funcionalidades como: edição de texto com destaque sintático, 
gerenciamento de múltiplos arquivos em abas, execução de scripts Python, consultas SQL com banco de dados SQLite embutido 
gerenciado por classes dedicadas (TSQLiteDb e TProjetoDB), extração de texto de documentos PDF e Word, além de comunicação TCP 
para recursos de fala e audição. O editor também incorpora integração com inteligência artificial via a API ChatGPT, permitindo 
análise, geração automática de código, consultas técnicas e interação direta dentro do ambiente. Sua interface é dinâmica, 
personalizável e conta com recursos como busca, histórico, associação de arquivos ao sistema operacional e suporte a múltiplos 
bancos, tudo isso assegurando um ambiente produtivo para manipulação avançada de notas e código.
