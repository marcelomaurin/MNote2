-- prestador_tipo
CREATE TABLE prestador_tipo (
  id_prestador INTEGER NOT NULL,
  id_tipo      INTEGER NOT NULL,
  id_marca     INTEGER, -- opcional 
(pode ser nulo)
  ativo        INTEGER NOT NULL DEFAULT 1,
  dtcad        VARCHAR(19) NOT NULL DEFAULT (datetime('now')),

  PRIMARY 
KEY (id_prestador, id_tipo, id_marca),

  CONSTRAINT fk_pt_prestador
    FOREIGN KEY (id_prestador) REFERENCES prestadores_pj(id)
    
ON UPDATE CASCADE
    ON DELETE CASCADE,

  CONSTRAINT fk_pt_tipo
    FOREIGN KEY (id_tipo) REFERENCES tipos_equipamento(id)
  
  ON UPDATE CASCADE
    ON DELETE CASCADE,

  CONSTRAINT fk_pt_marca
    FOREIGN KEY (id_marca) REFERENCES marcas(id)
    ON 
UPDATE CASCADE
    ON DELETE SET NULL
);

-- prestadores_pj
CREATE TABLE prestadores_pj (
  id                   INTEGER PRIMARY KEY AUTOINCREMENT,

  -- Identificação PJ
  razao_social          
VARCHAR(255) NOT NULL,
  nome_fantasia         VARCHAR(255),
  cnpj                 VARCHAR(20)  NOT NULL,
  inscricao_estadual    
VARCHAR(30),
  inscricao_municipal   VARCHAR(30),

  -- Endereço
  cep                  VARCHAR(15),
  logradouro            VARCHAR(255),
  
numero                VARCHAR(20),
  complemento           VARCHAR(100),
  bairro                VARCHAR(150),
  cidade                VARCHAR(150),
  
uf                   VARCHAR(2),   -- 'SP', 'RJ' etc.

  -- Contato
  telefone              VARCHAR(30),
  celular               VARCHAR(30),
  email                 
VARCHAR(255),
  site                  VARCHAR(255),

  -- Responsável
  responsavel_nome      VARCHAR(255),
  responsavel_cpf       VARCHAR
(20),
  responsavel_cargo     VARCHAR(100),

  -- Financeiro / Fiscal
  banco                 VARCHAR(100),
  agencia               VARCHAR(20),
  
conta                 VARCHAR(30),
  pix                   VARCHAR(100),
  chave_pix_tipo        VARCHAR(20),   -- 
'CPF','CNPJ','EMAIL','TELEFONE','ALEATORIA'
  regime_tributario     VARCHAR(30),   -- 
'SIMPLES','LUCRO_PRESUMIDO','LUCRO_REAL','OUTRO'

  -- Controle
  observacoes           TEXT,
  ativo                 INTEGER NOT NULL 
DEFAULT 1,  -- 1=true 0=false
  dtcad                 TEXT NOT NULL DEFAULT (datetime('now')),
  dtalt                 TEXT
, token VARCHAR(255));

