-- pessoas
CREATE TABLE pessoas (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  nome            VARCHAR(150) NOT NULL,
  email           
VARCHAR(150),

  vinculo_id      INTEGER,      -- FK para vinculos_pessoa.id

  -- ids vinculantes (opcionais)
  id_contrato     INTEGER,      -- 
contratos(id)
  id_prestador_pj INTEGER,      -- prestadores_pj(id)
  id_unidade      INTEGER,      -- unidades(id)
  id_os           INTEGER,      -- 
ordens_servico(id) (quando existir)

  ativo           INTEGER NOT NULL DEFAULT 1,
  dtcad           VARCHAR(19) NOT NULL DEFAULT 
(datetime('now')),
  dtalt           VARCHAR(19), token VARCHAR(255), celular VARCHAR(30),

  CONSTRAINT fk_pessoas_vinculo
    
FOREIGN KEY (vinculo_id) REFERENCES vinculos_pessoa(id)
    ON UPDATE CASCADE
    ON DELETE SET NULL,

  CONSTRAINT 
fk_pessoas_contrato
    FOREIGN KEY (id_contrato) REFERENCES contratos(id)
    ON UPDATE CASCADE
    ON DELETE SET NULL,

  
CONSTRAINT fk_pessoas_prestador
    FOREIGN KEY (id_prestador_pj) REFERENCES prestadores_pj(id)
    ON UPDATE CASCADE
    ON 
DELETE SET NULL,

  CONSTRAINT fk_pessoas_unidade
    FOREIGN KEY (id_unidade) REFERENCES unidades(id)
    ON UPDATE CASCADE
   
 ON DELETE SET NULL

  -- fk_pessoas_os será adicionada depois que a tabela ordens_servico existir
);

