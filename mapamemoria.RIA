  descricao                VARCHAR(255),

  classe_risco             VARCHAR(10),     -- 
I/II/III/IV ou Baixa/Media/Alta
  finalidade               VARCHAR(50),     -- Diagnostico/Terapia/Suporte a vida/Laboratorio...

  
exige_calibracao         INTEGER NOT NULL DEFAULT 0,
  calib_periodicidade_dias INTEGER,

  prev_periodicidade_dias  INTEGER,
  
preditiva_ativa          INTEGER NOT NULL DEFAULT 0,
  preditiva_parametros     VARCHAR(255),

  ativo                    INTEGER NOT NULL 
DEFAULT 1,
  dtcad                    VARCHAR(19) NOT NULL DEFAULT (datetime('now')),
  dtalt                    VARCHAR(19), 
PreventivaDiasComContrato INTEGER, exige_preventiva INTEGER NOT NULL DEFAULT 0, mandaemailcalibracaosemcontrato INTEGER 
NOT NULL DEFAULT 0, mandaemailcalibracaocomcontrato INTEGER NOT NULL DEFAULT 0,

  CONSTRAINT fk_tipo_categoria
    FOREIGN 
KEY (id_categoria) REFERENCES categorias(id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
);

